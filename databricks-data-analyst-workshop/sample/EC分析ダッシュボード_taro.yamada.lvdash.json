{
  "datasets": [
    {
      "name": "266dc444",
      "displayName": "users",
      "config": {
        "version": "1.1",
        "source": "data_analyst_workshop.bricksmart.users",
        "dimensions": [
          {
            "name": "user_id",
            "expr": "source.user_id",
            "comment": "ユーザーID",
            "displayName": "User Id"
          },
          {
            "name": "name",
            "expr": "source.name",
            "comment": "氏名",
            "displayName": "Name"
          },
          {
            "name": "age",
            "expr": "source.age",
            "comment": "年齢: 0以上",
            "displayName": "Age"
          },
          {
            "name": "gender",
            "expr": "source.gender",
            "comment": "性別: 例) 男性, 女性, 未回答, その他",
            "displayName": "Gender"
          },
          {
            "name": "email",
            "expr": "source.email",
            "comment": "メールアドレス",
            "displayName": "Email"
          },
          {
            "name": "registration_date",
            "expr": "source.registration_date",
            "comment": "登録日",
            "displayName": "Registration Date"
          },
          {
            "name": "region",
            "expr": "source.region",
            "comment": "地域: 例) 東京, 大阪, 北海道",
            "displayName": "Region"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "データセット内の行数の合計を表示します。この指標を使って、すべての行をカウントします。",
            "displayName": "カウント"
          }
        ]
      }
    }
  ],
